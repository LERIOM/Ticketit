# Copier en .env (jamais commité) puis remplacer chaque "change-me".
# Valeurs par défaut : développement directement sur la machine (localhost).
# Avec docker compose, docker-compose.yml remplace les URL par les noms de service.

# --- Module d'exécution (faux ou vrai executor de Florent, contrat v1)
EXECUTOR_URL=http://localhost:8100
EXECUTOR_API_KEY=change-me

# --- LLM : "ollama" (local, par défaut) ou "api" (option payante, texte masqué uniquement)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=bge-m3
ANTHROPIC_API_KEY=

# --- Neo4j (graphe + index vectoriel)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# --- Décision
DECISION_CONFIDENCE_THRESHOLD=0.75

# --- Table de pseudonymes chiffrée. Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# --- Langfuse (profil "observability", optionnel)
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
